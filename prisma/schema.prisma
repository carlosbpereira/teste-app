// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Categoria {
  BRINCO
  COLAR
  ANEL
  PULSEIRA
  CONJUNTO
}

enum StatusProduto {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

enum Localizacao {
  DONA
  REVENDEDORA
}

enum VendedoraTipo {
  DONA
  REVENDEDORA
}

enum FormaPagamento {
  PIX
  DEBITO
  CREDITO
  PROMISSORIA
}

enum StatusParcela {
  PENDENTE
  PAGO
  ATRASADO
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  telefone  String
  cpf       String?
  endereco  String?
  criadoEm DateTime @default(now()) @map("criado_em")

  vendas              Venda[]
  parcelasPromissoria ParcelaPromissoria[]

  @@map("clientes")
}

model Produto {
  id          String        @id @default(uuid())
  sku         String?       @unique
  nome        String
  descricao   String?
  categoria   Categoria
  precoCusto  Decimal       @map("preco_custo") @db.Decimal(10, 2)
  precoVenda  Decimal       @map("preco_venda") @db.Decimal(10, 2)
  fotoUrl     String?       @map("foto_url")
  status      StatusProduto @default(DISPONIVEL)
  localizacao Localizacao   @default(DONA)
  criadoEm   DateTime      @default(now()) @map("criado_em")

  itensVenda ItemVenda[]

  @@map("produtos")
}

model Venda {
  id            String         @id @default(uuid())
  clienteId     String         @map("cliente_id")
  vendedoraTipo VendedoraTipo  @map("vendedora_tipo")
  valorTotal    Decimal        @map("valor_total") @db.Decimal(10, 2)
  desconto      Decimal        @default(0) @db.Decimal(10, 2)
  valorFinal    Decimal        @map("valor_final") @db.Decimal(10, 2)
  formaPagamento FormaPagamento @map("forma_pagamento")
  criadoEm     DateTime       @default(now()) @map("criado_em")

  cliente    Cliente      @relation(fields: [clienteId], references: [id])
  itens      ItemVenda[]
  parcelas   ParcelaPromissoria[]

  @@map("vendas")
}

model ItemVenda {
  id             String  @id @default(uuid())
  vendaId        String  @map("venda_id")
  produtoId      String  @map("produto_id")
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(10, 2)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_venda")
}

model ParcelaPromissoria {
  id             String        @id @default(uuid())
  vendaId        String        @map("venda_id")
  clienteId      String        @map("cliente_id")
  numeroParcela  Int           @map("numero_parcela")
  valorParcela   Decimal       @map("valor_parcela") @db.Decimal(10, 2)
  dataVencimento DateTime      @map("data_vencimento")
  dataPagamento  DateTime?     @map("data_pagamento")
  status         StatusParcela @default(PENDENTE)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("parcelas_promissoria")
}
